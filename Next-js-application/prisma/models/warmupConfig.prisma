model WarmupConfig {
  id                Int      @id @default(autoincrement())
  userId            Int
  warmupEmailId     Int // references EmailConfig (sender)
  totalNoOfEmail    Int
  intervalInMin     Int
  recipientEmailIds Int[] // array of EmailConfig IDs
  startTime         DateTime @default(now())
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Relationships
  warmupEmail EmailConfig @relation("WarmupEmail", fields: [warmupEmailId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        Log[]

  @@index([warmupEmailId])
}
