generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String?
  providerToken String?
  provider      PROVIDER_TYPE  @default(BASIC)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailConfigs  EmailConfig[]
  warmups       WarmupConfig[]
}

model Log {
  id               Int          @id @default(autoincrement())
  warmupConfigId   Int
  senderEmailId    Int
  recipientEmailId Int
  scheduleTime     DateTime
  timestamp        DateTime     @default(now())
  status           STATUS_TYPE  @default(PENDING)
  errorMessage     String?
  recipient        EmailConfig  @relation("ReceiverEmail", fields: [recipientEmailId], references: [id], onDelete: Cascade)
  sender           EmailConfig  @relation("SenderEmail", fields: [senderEmailId], references: [id], onDelete: Cascade)
  warmupConfig     WarmupConfig @relation(fields: [warmupConfigId], references: [id], onDelete: Cascade)

  @@index([warmupConfigId])
  @@index([senderEmailId])
  @@index([recipientEmailId])
}

model EmailConfig {
  id               Int               @id @default(autoincrement())
  userId           Int
  email            String
  provider         EMAIL_PROVIDER    @default(GMAIL)
  accessToken      String?
  refreshToken     String
  expiryDate       DateTime?
  status           EMAIL_STATUS      @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  receivedLogs     Log[]             @relation("ReceiverEmail")
  sentLogs         Log[]             @relation("SenderEmail")
  warmups          WarmupConfig[]    @relation("WarmupEmail")
  warmupRecipients WarmupRecipient[]

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
}

model WarmupRecipient {
  id             Int          @id @default(autoincrement())
  warmupConfigId Int
  emailConfigId  Int
  emailConfig    EmailConfig  @relation(fields: [emailConfigId], references: [id], onDelete: Cascade)
  warmupConfig   WarmupConfig @relation(fields: [warmupConfigId], references: [id], onDelete: Cascade)

  @@index([warmupConfigId])
  @@index([emailConfigId])
}

model WarmupConfig {
  id               Int               @id @default(autoincrement())
  userId           Int
  warmupEmailId    Int
  totalNoOfEmail   Int
  minDelaySec      Int
  maxDelaySec      Int
  replyProbability Float
  startTime        DateTime
  createdAt        DateTime          @default(now())
  logs             Log[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  warmupEmail      EmailConfig       @relation("WarmupEmail", fields: [warmupEmailId], references: [id], onDelete: Cascade)
  recipients       WarmupRecipient[]

  @@index([warmupEmailId])
}

enum PROVIDER_TYPE {
  GOOGLE
  BASIC
}

enum EMAIL_PROVIDER {
  GMAIL
}

enum STATUS_TYPE {
  PENDING
  SENT
  REPLIED
  FAILED
}

enum EMAIL_STATUS {
  ACTIVE
  DISCONNECTED
  ERROR
  RECONNECT_REQUIRED
}
